<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pizzaria.controller.HomeController"
      alignment="CENTER"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="🍕Pizzaria Geométrica ooo"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <Button text="Clientes"
            prefWidth="250"
            onAction="#abrirClientes"/>

    <Button text="Pedidos"
            prefWidth="250"
            onAction="#abrirPedidos"/>

    <Button text="Sabores"
            prefWidth="250"
            onAction="#abrirSabores"/>

    <Button text="Preços"
            prefWidth="250"
            onAction="#abrirPrecos"/>

    <Button text="Status dos Pedidos"
            prefWidth="250"
            onAction="#abrirStatus"/>

    <Button text="Sair"
            prefWidth="250"
            onAction="#sair"/>
</VBox>
