<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pizzaria.controller.ClienteController">

    <top>

        <VBox spacing="10" style="-fx-padding:15;">

            <Label text="Cadastro de Clientes"
                   style="-fx-font-size:20px; -fx-font-weight:bold;"/>

            <GridPane hgap="10" vgap="10">

                <Label text="Nome:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtNome"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Sobrenome:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtSobrenome"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Telefone:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="txtTelefone"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="10">

                <Button text="Cadastrar"
                        onAction="#cadastrarCliente"/>

                <Button text="Atualizar"
                        onAction="#atualizarCliente"/>

                <Button text="Excluir"
                        onAction="#excluirCliente"/>

                <Button text="Limpar"
                        onAction="#limparCampos"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <VBox spacing="10" style="-fx-padding:15;">

            <HBox spacing="10">

                <Label text="Sobrenome:"/>

                <TextField fx:id="txtFiltroSobrenome"/>

                <Label text="Telefone:"/>

                <TextField fx:id="txtFiltroTelefone"/>

                <Button text="Pesquisar"
                        onAction="#pesquisarCliente"/>

            </HBox>

            <TableView fx:id="tblClientes">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="colNome"
                                 text="Nome"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colSobrenome"
                                 text="Sobrenome"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colTelefone"
                                 text="Telefone"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>
