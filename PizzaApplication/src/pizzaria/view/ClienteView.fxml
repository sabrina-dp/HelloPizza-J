<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pizzaria.controller.ClienteController"
            prefWidth="620" prefHeight="520"
            stylesheets="@style.css">

    <top>
        <VBox spacing="10" style="-fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

            <Label text="Cadastro de Clientes"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="8">
                <Label text="Nome:"        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNome" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Sobrenome:"        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtSobrenome" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Telefone:"        GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefone" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Cadastrar" onAction="#cadastrarCliente"
                        style="-fx-base: #3a7bd5; -fx-text-fill: white;"/>
                <Button text="Atualizar" onAction="#atualizarCliente"/>
                <Button text="Excluir"   onAction="#excluirCliente"/>
                <Button text="Limpar"    onAction="#limparCampos"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Sobrenome:"/>
                <TextField fx:id="txtFiltroSobrenome" prefWidth="160"/>
                <Label text="Telefone:"/>
                <TextField fx:id="txtFiltroTelefone" prefWidth="160"/>
                <Button text="Pesquisar" onAction="#pesquisarCliente"/>
            </HBox>

            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"        prefWidth="60"/>
                    <TableColumn fx:id="colNome"      text="Nome"      prefWidth="160"/>
                    <TableColumn fx:id="colSobrenome" text="Sobrenome" prefWidth="160"/>
                    <TableColumn fx:id="colTelefone"  text="Telefone"  prefWidth="150"/>
                </columns>
                <placeholder><Label text="Nenhum cliente cadastrado."/></placeholder>
            </TableView>
        </VBox>
    </center>

</BorderPane>
