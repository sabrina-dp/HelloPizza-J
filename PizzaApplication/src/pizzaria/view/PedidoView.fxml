<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680" prefWidth="700" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzaria.controller.PedidoController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Pedido de Pizza" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Telefone:" />
                <TextField fx:id="txtTelefone" prefWidth="160" promptText="(00) 00000-0000" />
                <Button onAction="#buscarCliente" text="Buscar Cliente" />
                <Label fx:id="lblCliente" style="-fx-text-fill: #666;" text="Nenhum cliente selecionado" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="15">
                <padding><Insets bottom="10" left="15" right="15" top="15" /></padding>

                <TitledPane collapsible="false" expanded="true" text="Montar Pizza">
                    <VBox spacing="12">
                        <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

                        <Label text="Forma" />
                        <HBox spacing="20">
                            <RadioButton fx:id="rbCirculo" text="Círculo" />
                            <RadioButton fx:id="rbQuadrado" text="Quadrado" />
                            <RadioButton fx:id="rbTriangulo" text="Triângulo" />
                        </HBox>

                        <HBox spacing="20">
                            <VBox spacing="5">
                                <Label text="Dimensão (raio ou lado em cm)" />
                                <TextField fx:id="txtDimensao" prefWidth="180" promptText="Ex: 15" />
                            </VBox>
                            <Label style="-fx-padding: 20 0 0 0;" text="ou" />
                            <VBox spacing="5">
                                <Label text="Área desejada (cm²)" />
                                <TextField fx:id="txtArea" prefWidth="180" promptText="100 – 1600" />
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <VBox spacing="5">
                                <Label text="Sabor 1 (obrigatório)" />
                                <ComboBox fx:id="cbSabor1" prefWidth="200" />
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Sabor 2 (opcional)" />
                                <ComboBox fx:id="cbSabor2" prefWidth="200" />
                            </VBox>
                        </HBox>

                        <HBox spacing="30">
                            <Label fx:id="lblAreaCalculada" style="-fx-font-weight: bold;" text="Área: —" />
                            <Label fx:id="lblPrecoPizza" style="-fx-font-weight: bold; -fx-text-fill: #2a7a2a;" text="Preço estimado: —" />
                        </HBox>

                        <Button onAction="#adicionarPizza" style="-fx-base: #3a7bd5; -fx-text-fill: white;" text="+ Adicionar Pizza ao Pedido" />
                    </VBox>
                </TitledPane>

                <TitledPane collapsible="false" expanded="true" text="Pizzas no Pedido">
                    <VBox spacing="10">
                        <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                        <TableView fx:id="tblItensPedido" prefHeight="220">
                            <columns>
                                <TableColumn fx:id="colForma" prefWidth="110" text="Forma" />
                                <TableColumn fx:id="colSabores" prefWidth="260" text="Sabores" />
                                <TableColumn fx:id="colArea" prefWidth="120" text="Área (cm²)" />
                                <TableColumn fx:id="colPreco" prefWidth="120" text="Preço" />
                            </columns>
                            <placeholder><Label text="Nenhuma pizza adicionada ainda." /></placeholder>
                        </TableView>
                    </VBox>
                </TitledPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
            <Label text="Total do Pedido:" />
            <Label fx:id="lblTotalPedido" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2a7a2a;" text="R$ 0,00" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#removerPizza" text="Remover Pizza" />
            <Button onAction="#salvarPedido" style="-fx-base: #3a7bd5; -fx-text-fill: white;" text="Salvar Pedido" />
        </HBox>
    </bottom>

</BorderPane>
