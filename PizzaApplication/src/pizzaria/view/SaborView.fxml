<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520" prefWidth="620" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pizzaria.controller.SaborController" stylesheets="@style.css">

    <top>
        <VBox spacing="10" style="-fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Cadastro de Sabores" />

            <GridPane hgap="10" vgap="8">
                <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNomeSabor" prefWidth="250" promptText="Ex: Calabresa" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbTipoPizza" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox spacing="10">
                <Button onAction="#cadastrarSabor" style="-fx-base: #3a7bd5; -fx-text-fill: white;" text="Cadastrar" />
                <Button onAction="#atualizarSabor" text="Atualizar" />
                <Button onAction="#excluirSabor" text="Excluir" />
                <Button onAction="#limparCampos" text="Limpar" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Pesquisar:" />
                <TextField fx:id="txtPesquisa" prefWidth="250" promptText="Buscar pelo nome..." />
                <Button onAction="#pesquisarSabor" text="Pesquisar" />
            </HBox>

            <TableView fx:id="tblSabores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNome" prefWidth="300" text="Sabor" />
                    <TableColumn fx:id="colTipo" prefWidth="180" text="Tipo" />
                </columns>
                <placeholder><Label text="Nenhum sabor cadastrado ou encontrado." /></placeholder>
            </TableView>

            <Label fx:id="lblTotalSabores" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2a7a2a;" text="Total de sabores: 0" />
        </VBox>
    </center>

</BorderPane>
